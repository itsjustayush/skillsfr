{
  "name": "skillsfr",
  "version": "1.0.0",
  "description": "The centralized, community-driven developer resource registry for AI agents and developers.",
  "type": "module",
  "bin": {
    "skillsfr": "./bin/skillsfr.js"
  },
  "files": [
    "bin",
    "dist",
    "registry"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "sync": "python scripts/discover.py && python scripts/classify.py && python scripts/rank.py && python scripts/generate_readme.py",
    "refresh-readme": "python scripts/generate_readme.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "lucide-react": "^0.475.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
